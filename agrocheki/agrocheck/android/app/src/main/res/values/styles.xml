<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema mostrado por Android mientras Flutter aún no ha dibujado su
         primer frame. Usa el mismo verde oscuro que nuestro splash animado
         para que la transición sea invisible. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Tema usado por la Activity una vez que Flutter ya tomó el control. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
